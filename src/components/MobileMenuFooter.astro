---
/**
 * MobileMenuFooter — Starlight override.
 * Adds the ShipWithAI nav links + Subscribe CTA (desktop header items that are
 * hidden below the lg breakpoint) to the mobile slide-out menu.
 */
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import { headerNav, headerCta, pageHasNewsletter, type Locale } from '../config/navigation';

const route = Astro.locals.starlightRoute;
const locale: Locale = route?.lang?.startsWith('vi') ? 'vi' : 'en';
const nav = headerNav[locale];
const cta = {
  label: headerCta[locale].label,
  href: pageHasNewsletter(route) ? '#newsletter' : headerCta[locale].fallbackHref,
};
---

<nav class="mobile-site-nav" aria-label="ShipWithAI">
  {nav.map((item) => (
    <a class="mobile-site-nav__link" href={item.href}>{item.label}</a>
  ))}
  <a class="mobile-site-nav__cta" href={cta.href}>{cta.label}</a>
</nav>

<div class="mobile-preferences sl-flex">
  <div class="social-icons">
    <SocialIcons />
  </div>
  <LanguageSelect />
</div>

<style>
  @layer starlight.core {
    .social-icons {
      display: flex;
      margin-inline-end: auto;
      gap: 1rem;
      align-items: center;
      padding-block: 1rem;
    }
    .social-icons:empty {
      display: none;
    }
    .mobile-preferences {
      justify-content: space-between;
      flex-wrap: wrap;
      border-top: 1px solid var(--sl-color-gray-6);
      column-gap: 1rem;
      padding: 0.5rem 0;
    }
  }

  .mobile-site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--sl-color-gray-6);
  }
  .mobile-site-nav__link {
    font-family: var(--type-family-body);
    font-size: var(--type-scale-sm);
    font-weight: var(--type-weight-medium);
    color: var(--text-secondary);
    text-decoration: none;
  }
  .mobile-site-nav__link:hover { color: var(--text-primary); }
  .mobile-site-nav__cta {
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding-inline: var(--space-4);
    font-family: var(--type-family-body);
    font-size: var(--type-scale-sm);
    font-weight: var(--type-weight-medium);
    color: var(--text-inverse);
    background: var(--accent-product);
    border-radius: var(--radius-full);
    text-decoration: none;
  }
  .mobile-site-nav__cta:hover { background: var(--accent-product-hover); color: var(--text-inverse); }
</style>

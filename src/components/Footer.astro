---
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
import NewsletterCta from './NewsletterCta.astro';
import {
  footerLinks,
  footerExploreLinks,
  socialLinks,
  type Locale,
  type SocialId,
} from '../config/navigation';

const route = Astro.locals.starlightRoute;
const locale: Locale = route?.lang?.startsWith('vi') ? 'vi' : 'en';
const year = new Date().getFullYear();

const links = footerLinks[locale];
const exploreLinks = footerExploreLinks[locale];

const i18n = {
  tagline: locale === 'vi'
    ? 'Giúp developer ship nhanh hơn với AI.'
    : 'Helping developers ship faster with AI.',
  quickLinks: locale === 'vi' ? 'Liên kết' : 'Quick Links',
  explore: locale === 'vi' ? 'Khám phá' : 'Explore',
  connect: locale === 'vi' ? 'Kết nối' : 'Connect',
  rss: 'RSS Feed',
};

// Simple Icons paths (24×24, fill=currentColor). Keyed by SocialId so the
// markup below stays a single loop instead of one branch per network.
const socialIconPaths: Record<SocialId, string> = {
  github:
    'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z',
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  telegram:
    'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z',
};

const externalIcon = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>`;

const rssHref = locale === 'vi' ? 'https://shipwithai.io/vi/rss.xml' : 'https://shipwithai.io/rss.xml';
---

<!-- GTM noscript fallback (ideally right after <body>, but Starlight doesn't expose that) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MJJNTKQR"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<footer class="sl-flex starlight-meta">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />

  {
    config.credits && (
      <a class="kudos sl-flex" href="https://starlight.astro.build">
        <Icon name={'starlight'} /> {Astro.locals.t('builtWithStarlight.label')}
      </a>
    )
  }
</footer>

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">

      <!-- Brand -->
      <div class="footer-brand">
        <a class="footer-logo" href="https://shipwithai.io">
          <svg class="footer-logo-icon" width="20" height="20" viewBox="0 0 128 128" aria-hidden="true" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M81 36 64 0 47 36l-1 2-9-10a6 6 0 0 0-9 9l10 10h-2L0 64l36 17h2L28 91a6 6 0 1 0 9 9l9-10 1 2 17 36 17-36v-2l9 10a6 6 0 1 0 9-9l-9-9 2-1 36-17-36-17-2-1 9-9a6 6 0 1 0-9-9l-9 10v-2Zm-17 2-2 5c-4 8-11 15-19 19l-5 2 5 2c8 4 15 11 19 19l2 5 2-5c4-8 11-15 19-19l5-2-5-2c-8-4-15-11-19-19l-2-5Z" />
            <path d="M118 19a6 6 0 0 0-9-9l-3 3a6 6 0 1 0 9 9l3-3Zm-96 4c-2 2-6 2-9 0l-3-3a6 6 0 1 1 9-9l3 3c3 2 3 6 0 9Zm0 82c-2-2-6-2-9 0l-3 3a6 6 0 1 0 9 9l3-3c3-2 3-6 0-9Zm96 4a6 6 0 0 1-9 9l-3-3a6 6 0 1 1 9-9l3 3Z" />
          </svg>
          <span>ShipWithAI</span>
        </a>
        <p class="footer-tagline">{i18n.tagline}</p>

        <div class="footer-social">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-link"
              aria-label={link.label}
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={socialIconPaths[link.id]} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer-section">
        <h2 class="footer-heading">{i18n.quickLinks}</h2>
        <ul class="footer-links">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={{ 'external-link': link.external }}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
                {link.external && <Fragment set:html={externalIcon} />}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Explore -->
      <div class="footer-section">
        <h2 class="footer-heading">{i18n.explore}</h2>
        <ul class="footer-links">
          {exploreLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
          <li>
            <a href={rssHref} target="_blank" rel="noopener noreferrer" class="external-link">
              {i18n.rss}
              <Fragment set:html={externalIcon} />
            </a>
          </li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div class="footer-section footer-newsletter">
        <NewsletterCta locale={locale} variant="flat" id="newsletter-footer" />
      </div>

    </div>

    <!-- Connect row — text links shown below the grid once the icon row is hidden (≤768px) -->
    <div class="footer-connect-row">
      <h2 class="footer-heading">{i18n.connect}</h2>
      <ul class="footer-links footer-links--inline">
        {socialLinks.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="external-link">
              {link.label}
              <Fragment set:html={externalIcon} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} ShipWithAI</p>
    </div>
  </div>
</footer>

<style>
  @layer starlight.core {
    .starlight-meta {
      flex-direction: column;
      gap: 1.5rem;
    }
    .meta {
      gap: 0.75rem 3rem;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-top: 3rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }
    .meta > :global(p:only-child) {
      margin-inline-start: auto;
    }
    .kudos {
      align-items: center;
      gap: 0.5em;
      margin: 1.5rem auto;
      font-size: var(--sl-text-xs);
      text-decoration: none;
      color: var(--sl-color-gray-3);
    }
    .kudos:hover {
      color: var(--sl-color-white);
    }
  }

  @layer starlight.components {
    .kudos :global(svg) {
      color: var(--sl-color-orange);
    }
  }

  /* ── Site-wide footer (ported from shipwithai.io SiteFooter) ─── */
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-deepest);
    margin-top: var(--space-2xl);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-lg) var(--space-xl);
  }

  /* brand(2fr) · quick links(1fr) · explore(1fr) · newsletter(1.5fr) */
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: var(--space-xl);
  }

  /* Brand column */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-weight: var(--type-weight-semibold);
    font-size: var(--text-base);
  }

  .footer-logo-icon {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .footer-tagline {
    margin: var(--space-2) 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }

  .footer-social {
    display: flex;
    gap: var(--space-2);
  }

  .social-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }

  .social-icon-link:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-hover);
    background: var(--color-accent-subtle);
  }

  /* Link columns */
  .footer-heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--type-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-links li + li {
    margin-top: var(--space-2);
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--color-text-primary);
  }

  .external-link :global(svg) {
    opacity: 0.6;
    flex-shrink: 0;
  }

  /* Connect row — desktop shows the icon buttons instead */
  .footer-connect-row {
    display: none;
    margin-top: var(--space-xl);
  }

  .footer-links--inline {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }

  .footer-links--inline li + li {
    margin-top: 0;
  }

  /* Bottom bar */
  .footer-bottom {
    margin-top: var(--space-xl);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-accent-subtle);
    text-align: center;
  }

  .footer-bottom p {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Responsive: 2 cols ≤768 (brand spans), 1 col ≤480 */
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl) var(--space-lg);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-social {
      display: none;
    }

    .footer-connect-row {
      display: block;
    }
  }

  @media (max-width: 480px) {
    .footer-inner {
      padding: var(--space-2xl) var(--space-md) var(--space-lg);
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .footer-brand {
      grid-column: auto;
    }
  }
</style>

<script>
  import '../scripts/course-analytics';
</script>
